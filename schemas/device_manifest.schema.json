{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hot40i-llm-node.local/schemas/device_manifest.schema.json",
  "title": "Hot40i device manifest",
  "type": "object",
  "required": ["schema_version", "captured_at", "adb_devices", "serial", "summary", "probes"],
  "properties": {
    "schema_version": {"const": 1},
    "captured_at": {"type": "string"},
    "adb_devices": {"type": "string"},
    "serial": {"type": ["string", "null"]},
    "summary": {
      "type": "object",
      "required": [
        "product",
        "model",
        "device",
        "manufacturer",
        "brand",
        "android_release",
        "sdk",
        "build_fingerprint",
        "hardware",
        "board_platform",
        "soc",
        "boot_devices",
        "ddrsize",
        "slot_suffix",
        "dynamic_partitions",
        "verified_boot_state",
        "mem_total_bytes",
        "mem_available_bytes",
        "cpu_online",
        "processor_count",
        "storage_roots",
        "data_filesystem",
        "thermal_zone_count"
      ],
      "properties": {
        "product": {"type": ["string", "null"]},
        "model": {"type": ["string", "null"]},
        "device": {"type": ["string", "null"]},
        "manufacturer": {"type": ["string", "null"]},
        "brand": {"type": ["string", "null"]},
        "android_release": {"type": ["string", "null"]},
        "sdk": {"type": ["string", "null"]},
        "build_fingerprint": {"type": ["string", "null"]},
        "hardware": {"type": ["string", "null"]},
        "board_platform": {"type": ["string", "null"]},
        "soc": {"type": ["string", "null"]},
        "boot_devices": {"type": ["string", "null"]},
        "ddrsize": {"type": ["string", "null"]},
        "slot_suffix": {"type": ["string", "null"]},
        "dynamic_partitions": {"type": ["string", "null"]},
        "verified_boot_state": {"type": ["string", "null"]},
        "mem_total_bytes": {"type": ["integer", "null"]},
        "mem_available_bytes": {"type": ["integer", "null"]},
        "cpu_online": {"type": ["string", "null"]},
        "processor_count": {"type": ["integer", "null"]},
        "storage_roots": {"type": "array", "items": {"type": "string"}},
        "data_filesystem": {"type": ["string", "null"]},
        "thermal_zone_count": {"type": "integer"}
      },
      "additionalProperties": false
    },
    "probes": {
      "type": "object",
      "minProperties": 5,
      "additionalProperties": {
        "type": "object",
        "required": ["command", "returncode", "stdout", "stderr"],
        "properties": {
          "command": {"type": "string"},
          "returncode": {"type": "integer"},
          "stdout": {"type": "string"},
          "stderr": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
